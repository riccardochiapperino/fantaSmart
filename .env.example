# Copia questo file in `.env.local` (in locale) e imposta le stesse variabili su Vercel
# (Settings -> Environment Variables). Dopo averle modificato su Vercel serve un nuovo deploy.
#
# Le password non hanno un valore di default nel codice: se una password è vuota,
# l'account corrispondente (admin / utente) è disabilitato.
#
# ATTENZIONE: le variabili NEXT_PUBLIC_* vengono incluse nel bundle JavaScript
# e sono quindi leggibili da chiunque apra l'app. Non riutilizzare password usate altrove.

NEXT_PUBLIC_ADMIN_USER=admin
NEXT_PUBLIC_ADMIN_PASS=
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

NEXT_PUBLIC_USER_NAME=utente
NEXT_PUBLIC_USER_PASS=
NEXT_PUBLIC_USER_EMAIL=utente@example.com
